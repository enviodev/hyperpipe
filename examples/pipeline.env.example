# HyperPipe environment file. Copy to `pipeline.env` and fill in.
# Loaded by scripts/run.sh; also works with `set -a; source pipeline.env; set +a`.

# HyperSync API token (required for live/real chains).
# Create at https://app.envio.dev/api-tokens
HYPERSYNC_BEARER_TOKEN=

# Pipeline secrets. A `${secret:NAME}` in the YAML resolves to HYPERPIPE_SECRET_<NAME>.
HYPERPIPE_SECRET_PG_MAIN_DSN=postgres://user:password@localhost:5432/hyperpipe
HYPERPIPE_SECRET_SLACK_WEBHOOK=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# S3 sink credentials (only when an `s3` connection has no local_path).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_ENDPOINT=            # for R2 / MinIO

# Logging (target=level, comma-separated).
RUST_LOG=hyperpipe=info
